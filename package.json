{
  "name": "tex-service",
  "version": "0.1.0",
  "description": "TeX Live as an HTTP compile service: latexmk, SyncTeX, texcount and poppler in one container, with a TypeScript client.",
  "license": "MIT",
  "author": "Dev Bilaspure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-Bilaspure/tex-service.git"
  },
  "homepage": "https://github.com/Dev-Bilaspure/tex-service#readme",
  "bugs": "https://github.com/Dev-Bilaspure/tex-service/issues",
  "keywords": [
    "latex",
    "tex",
    "texlive",
    "latexmk",
    "synctex",
    "pdf",
    "compiler",
    "docker"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "tex-service": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/fixtures",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "docker:build": "docker build -t tex-service .",
    "docker:test": "docker build -t tex-service . && docker run --rm --entrypoint node tex-service --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2"
}
