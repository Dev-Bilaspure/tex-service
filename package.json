{
  "name": "@resume-studio/tex-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TeX toolchain (TeX Live, latexmk, SyncTeX, poppler) as a small HTTP service, and its client.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "tex-service": "./bin/tex-service.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "bin": {
      "tex-service": "./dist/main.js"
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
